{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__hackmd__get.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/mark-baseline.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__hackmd__update.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-update-note.sh\""
          }
        ]
      }
    ]
  }
}
